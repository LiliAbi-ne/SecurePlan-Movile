# =============================================================================
# Plantilla de variables de entorno. Copiar a ".env" y rellenar valores reales.
# NUNCA versionar el archivo ".env".
# =============================================================================

# --- Aplicación ---
APP_NAME="Agenda API"
ENVIRONMENT=development          # development | staging | production
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Seguridad / JWT ---
# Genera una clave robusta con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=cambiame-por-una-clave-aleatoria-de-al-menos-32-caracteres
JWT_ALGORITHM=HS256
JWT_ISSUER=agenda-api
ACCESS_TOKEN_EXPIRE_MINUTES=15

# --- MongoDB ---
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=agenda

# --- CORS (formato JSON; lista de orígenes permitidos) ---
# En producción sustituir por dominios concretos, nunca "*".
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]
